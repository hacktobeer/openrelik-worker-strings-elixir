# Release runtime environment hooks (see `mix release` docs). This script is
# sourced by the generated `bin/openrelik_worker_strings` release script for
# every command.

# Enable container-local Erlang distribution so operator tooling (and the
# Dockerfile HEALTHCHECK `ping`) can reach the running node. Distribution is
# not used by the Redis-based Celery worker itself; the RELEASE_COOKIE below is
# a fixed container-loopback-only liveness value. Environment overrides still
# win via the default substitutions below.
#
# Note: the release script accepts only `sname`, `name`, or `none` for
# RELEASE_DISTRIBUTION.
case "${RELEASE_COMMAND:-}" in
  start | daemon | start_iex | ping | rpc | eval)
    export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"
    export RELEASE_NODE="${RELEASE_NODE:-openrelik_worker_strings}"
    export RELEASE_COOKIE="${RELEASE_COOKIE:-openrelik-worker-strings}"
    ;;
  *)
    # Other commands (console during development, etc.) run non-distributed.
    :
    ;;
esac
